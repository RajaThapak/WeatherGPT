# --- REQUIRED for this scaffold pass ---
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:weathergpt_dev_password@localhost:5432/weathergpt
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# --- Not used until later passes — leave blank until you have real keys ---

# Auth (BE-2)
