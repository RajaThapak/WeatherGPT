# Voice (BE-8) — Rime paid TTS
RIME_API_KEY=

# Maps (FE-6) — MapTiler free tier
MAPTILER_API_KEY=

# Weather/climate data (BE-3, BE-10)
DATA_GOV_IN_API_KEY=
CDS_API_KEY=
